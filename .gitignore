__pycache__/
*.pyc
.venv/
.DS_Store

# Generated artefacts. These live on the `data` branch, not on main —
# see .github/workflows/fetch.yml. Keeping them off main means the commit
# history stays readable and the repository doesn't grow by a binary
# SQLite diff every hour.
data/*
!data/.gitkeep
docs/*
!docs/.gitkeep
